[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "breathtestcore"]
	path = breathtestcore
	url = https://github.com/dmenne/breathtestcore
[submodule "breathteststan"]
	path = breathteststan
	url = https://github.com/dmenne/breathteststan
[submodule "cmdstanr"]
	path = cmdstanr
	url = https://github.com/stan-dev/cmdstanr
	registered = false
[submodule "gastempt"]
	path = gastempt
	url = https://github.com/dmenne/gastempt
